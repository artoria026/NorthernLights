# pgAdmin (optional, see docker-compose.yml, "tools" profile) -- only needed
# if you're going to bring up that service. Compose reads this variable from
# a .env at the repo root, not from backend/.env -- copy this line there if
# you need it.
PGADMIN_PASSWORD=changeme

# Database -- port 5432 assumes native Postgres (not Docker, see
# docker-compose.yml). Adjust the port if your machine already has another
# Postgres there. Create the role/DB once:
#   createuser -h localhost -p 5432 finanzas_user -P   # prompts for the password
#   createdb -h localhost -p 5432 -O finanzas_user finanzas_dev
#   createdb -h localhost -p 5432 -O finanzas_user finanzas_test   # for pytest
DATABASE_URL=postgresql+asyncpg://finanzas_user:finanzas_dev_pass@localhost:5432/finanzas_dev

# Password for the read-only role (BYPASSRLS) used for the Admin panel's
# cross-user aggregations -- see migration 74f91ad52f09. Only matters when
# creating the role by hand (an infra step, requires superuser -- see "Setup
# on a new machine" in README.md); the app connects with SET LOCAL ROLE over
# the normal connection, never with this password directly.
ADMIN_DB_PASSWORD=

# Redis (DB 0 for the app, DB 1 for the Celery broker, DB 2 for Celery results).
# If your Redis requires a password (requirepass), use redis://:PASSWORD@host:port/db.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth JWT
SECRET_KEY=CHANGE-FOR-RANDOM-64-CHAR-STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin user -- read by migration b7e2a4c910f3 when running
# `alembic upgrade head`. If left empty, that migration doesn't create
# anything (doesn't break the deploy). Only matter the first time that
# migration runs on each database -- it's idempotent, doesn't overwrite the
# password afterward.
ADMIN_EMAIL=admin@finanzas.app
ADMIN_PASSWORD=admin
ADMIN_NAME=Admin

# Google OAuth -- empty until you create a real project in Google Cloud
# Console (see guide). GOOGLE_REDIRECT_URI must match EXACTLY what you
# register there as "Authorized redirect URI".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI Provider (gemini is the project's current default; claude is also supported)
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-flash-latest
AI_MAX_TOKENS=16384
AI_RATE_LIMIT_PER_USER_DAY=30

# Email (real provider TBD -- without this, app/tasks/email.py only logs)
EMAIL_FROM=noreply@finanzas.app
FRONTEND_URL=http://localhost:5173

# Push notifications (Firebase) -- empty until you have a real Firebase project;
# without this, push_service.py doesn't send anything (silent no-op)
FIREBASE_CREDENTIALS_JSON=

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOG_FORMAT=console
