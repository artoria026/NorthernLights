# Base de datos -- puerto 5432 asume Postgres nativo (no Docker, ver
# docker-compose.yml). Ajusta el puerto si tu maquina ya tiene otro Postgres
# ahi. Crear el rol/BD una sola vez:
#   createuser -h localhost -p 5432 finanzas_user -P   # pide el password
#   createdb -h localhost -p 5432 -O finanzas_user finanzas_dev
#   createdb -h localhost -p 5432 -O finanzas_user finanzas_test   # para pytest
DATABASE_URL=postgresql+asyncpg://finanzas_user:finanzas_dev_pass@localhost:5432/finanzas_dev

# Password del rol de solo lectura (BYPASSRLS) para las agregaciones
# cross-usuario del panel de Admin -- ver migracion 74f91ad52f09. Solo importa
# al crear el rol a mano (paso de infra, requiere superuser -- ver "Setup en
# una maquina nueva" en README.md); la app se conecta con SET LOCAL ROLE
# sobre la conexion normal, nunca con esta password directamente.
ADMIN_DB_PASSWORD=

# Redis (DB 0 para app, DB 1 para Celery broker, DB 2 para Celery results).
# Si tu Redis pide password (requirepass), usa redis://:PASSWORD@host:port/db.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth JWT
SECRET_KEY=CAMBIAR-POR-STRING-ALEATORIO-64-CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Usuario admin -- leidas por la migracion b7e2a4c910f3 al correr
# `alembic upgrade head`. Si se dejan vacias, esa migracion no crea nada (no
# rompe el deploy). Solo importan la primera vez que corre esa migracion en
# cada base de datos -- es idempotente, no pisa la contrasena despues.
ADMIN_EMAIL=admin@finanzas.app
ADMIN_PASSWORD=admin
ADMIN_NAME=Admin

# Google OAuth -- vacios hasta crear un proyecto real en Google Cloud Console
# (ver guia). GOOGLE_REDIRECT_URI debe coincidir EXACTO con el que registres
# ahi como "Authorized redirect URI".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI Provider (gemini es el default actual del proyecto; claude tambien esta soportado)
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-flash-latest
AI_MAX_TOKENS=16384
AI_RATE_LIMIT_PER_USER_DAY=30

# Email (proveedor real TBD -- sin esto, app/tasks/email.py solo loguea)
EMAIL_FROM=noreply@finanzas.app
FRONTEND_URL=http://localhost:5173

# Push notifications (Firebase) -- vacio hasta tener un proyecto Firebase real;
# sin esto, push_service.py no envia nada (no-op silencioso)
FIREBASE_CREDENTIALS_JSON=

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOG_FORMAT=console
