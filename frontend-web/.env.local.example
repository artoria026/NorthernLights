VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

# Muestra el boton "Usar cuenta de prueba" en /login -- ademas requiere modo
# dev (import.meta.env.DEV, false en cualquier `vite build`). Dejar vacio o
# en false para no verlo ni siquiera corriendo `vite dev`.
VITE_ENABLE_DEV_LOGIN=true
